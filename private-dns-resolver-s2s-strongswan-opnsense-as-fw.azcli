az network nic create -g $rg -n $h1spoke_vnet_name -l $location --vnet-name $h1spoke_vnet_name --subnet $h1spoke_vm_subnet_name -o none
az vm create -g $rg -n $h1spoke_vnet_name -l $location --image Win2022Datacenter --nics $h1spoke_vnet_name --os-disk-name $h1spoke_vnet_name --size $win_vm_size --admin-username $admin_username --admin-password $admin_password --no-wait
h1spoke_vm_ip=$(az network nic show -g $rg -n $h1spoke_vnet_name --query ipConfigurations[0].privateIPAddress -o tsv | tr -d '\r') && echo $h1spoke_vnet_name vm private ip: $h1spoke_vm_ip

# h1spoke-lx vm
echo -e "\e[1;36mDeploying $h1spoke_vnet_name-lx VM...\e[0m"
az network nic create -g $rg -n $h1spoke_vnet_name-lx -l $location --vnet-name $h1spoke_vnet_name --subnet $h1spoke_vm_subnet_name -o none
az vm create -g $rg -n $h1spoke_vnet_name-lx -l $location --image Ubuntu2204 --nics $h1spoke_vnet_name-lx --os-disk-name $h1spoke_vnet_name-lx --size $vm_size --admin-username $admin_username --admin-password $admin_password --no-wait
h1spoke_lx_vm_ip=$(az network nic show -g $rg -n $h1spoke_vnet_name-lx --query ipConfigurations[0].privateIPAddress -o tsv | tr -d '\r') && echo $h1spoke_vnet_name-lx vm private ip: $h1spoke_lx_vm_ip

# o1spoke vm
echo -e "\e[1;36mDeploying $o1spoke_vnet_name VM...\e[0m"
az network nic create -g $rg -n $o1spoke_vnet_name -l $location --vnet-name $o1spoke_vnet_name --subnet $o1spoke_vm_subnet_name -o none
az vm create -g $rg -n $o1spoke_vnet_name -l $location --image Win2022Datacenter --nics $o1spoke_vnet_name --os-disk-name $o1spoke_vnet_name --size $win_vm_size --admin-username $admin_username --admin-password $admin_password --no-wait
o1spoke_vm_ip=$(az network nic show -g $rg -n $o1spoke_vnet_name --query ipConfigurations[0].privateIPAddress -o tsv | tr -d '\r') && echo $o1spoke_vnet_name vm private ip: $o1spoke_vm_ip

# o1spoke-lx vm
echo -e "\e[1;36mDeploying $o1spoke_vnet_name-lx VM...\e[0m"
az network nic create -g $rg -n $o1spoke_vnet_name-lx -l $location --vnet-name $o1spoke_vnet_name --subnet $o1spoke_vm_subnet_name -o none
az vm create -g $rg -n $o1spoke_vnet_name-lx -l $location --image Ubuntu2204 --nics $o1spoke_vnet_name-lx --os-disk-name $o1spoke_vnet_name-lx --size $vm_size --admin-username $admin_username --admin-password $admin_password --no-wait
o1spoke_lx_vm_ip=$(az network nic show -g $rg -n $o1spoke_vnet_name-lx --query ipConfigurations[0].privateIPAddress -o tsv | tr -d '\r') && echo $o1spoke_vnet_name-lx vm private ip: $o1spoke_lx_vm_ip

# create storage account
stor_name=wadstor$RANDOM
echo -e "\e[1;36mCreating a storage account ($stor_name)...\e[0m"
az storage account create -g $rg -n $stor_name --access-tier Hot --sku Standard_LRS -o none
blobid=$(az storage account show -g $rg -n $stor_name --query id -o tsv | tr -d '\r')
blob_endpoint=$(az storage account show -g $rg -n $stor_name --query primaryEndpoints.blob -o tsv | tr -d '\r' |sed -e 's|^https://||' |sed -e 's|/$||') && echo $stor_name blob endpoint: $blob_endpoint

# Creating a private endpoint
echo -e "\e[1;36mCreating a private endpoint for storage account($stor_name)...\e[0m"
az network private-endpoint create -g $rg -n $stor_name-blobpe --connection-name connection --private-connection-resource-id $blobid --subnet $h1spoke_vm_subnet_name --group-id blob --vnet-name $h1spoke_vnet_name --nic-name $stor_name-blobpe-nic -o none
echo -e "\e[1;36mCreating a private DNS zone for privatelink.blob.core.windows.net...\e[0m"
az network private-dns zone create -g $rg -n privatelink.blob.core.windows.net -o none
# Link the private DNS zone to the VNets
echo -e "\e[1;36mLinking the private DNS zone for privatelink.blob.core.windows.net to $hub1_vnet_name and $h1spoke_vnet_name VNets...\e[0m"
az network private-dns link vnet create -g $rg -n $hub1_vnet_name-dns-link --zone-name privatelink.blob.core.windows.net --virtual-network $hub1_vnet_name --registration-enabled false -o none
az network private-dns link vnet create -g $rg -n $h1spoke_vnet_name-dns-link --zone-name privatelink.blob.core.windows.net --virtual-network $h1spoke_vnet_name --registration-enabled false -o none
echo -e "\e[1;36mCreating a record in privatelink.blob.core.windows.net for $stor_name-blobpe...\e[0m"
az network private-endpoint dns-zone-group create -g $rg -n zone-group --endpoint-name $stor_name-blobpe --private-dns-zone privatelink.blob.core.windows.net --zone-name blob -o none

echo -e "\e[1;36mAllowing ICMP on windows VMs...\e[0m"
icmp_file=icmp.ps1
cat <<EOF > $icmp_file
Get-NetFirewallRule -DisplayName "File and Printer Sharing (Echo Request - ICMPv4-In)" | Enable-NetFirewallRule 
Get-NetFirewallRule -DisplayName "File and Printer Sharing (Echo Request - ICMPv6-In)" | Enable-NetFirewallRule 
Get-NetFirewallRule -DisplayName "Virtual Machine Monitoring (Echo Request - ICMPv4-In)" | Enable-NetFirewallRule 
Get-NetFirewallRule -DisplayName "Virtual Machine Monitoring (Echo Request - ICMPv6-In)" | Enable-NetFirewallRule
EOF

az vm run-command invoke -g $rg -n $hub1_vnet_name --command-id RunPowerShellScript --scripts @$icmp_file --no-wait
az vm run-command invoke -g $rg -n $h1spoke_vnet_name --command-id RunPowerShellScript --scripts @$icmp_file --no-wait
az vm run-command invoke -g $rg -n $onprem1_vnet_name --command-id RunPowerShellScript --scripts @$icmp_file --no-wait
az vm run-command invoke -g $rg -n $o1spoke_vnet_name --command-id RunPowerShellScript --scripts @$icmp_file --no-wait

rm $icmp_file

# Download config files
hub1_config=~/hub1-config.xml
curl -o $hub1_config https://raw.githubusercontent.com/wshamroukh/azure-private-dns-resolver/refs/heads/main/hub1-config.xml
   
onprem1_config=~/onprem1-config.xml
curl -o $onprem1_config https://raw.githubusercontent.com/wshamroukh/azure-private-dns-resolver/refs/heads/main/onprem1-config.xml

# hub1 fw opnsense bootstrap
mv $hub1_config ~/config.xml
echo -e "\e[1;36mCopying configuration files to $hub1_vnet_name-fw and installing opnsense firewall...\e[0m"
scp -o StrictHostKeyChecking=no $opnsense_init_file ~/config.xml $admin_username@$hub1_fw_public_ip:/home/$admin_username
ssh -o StrictHostKeyChecking=no $admin_username@$hub1_fw_public_ip "chmod +x /home/$admin_username/opnsense_init.sh && sh /home/$admin_username/opnsense_init.sh"
rm ~/config.xml

# onprem1 fw opnsense bootstrap
mv $onprem1_config ~/config.xml
echo -e "\e[1;36mCopying configuration files to $onprem1_vnet_name-fw and installing opnsense firewall...\e[0m"
scp -o StrictHostKeyChecking=no $opnsense_init_file ~/config.xml $admin_username@$onprem1_fw_public_ip:/home/$admin_username
ssh -o StrictHostKeyChecking=no $admin_username@$onprem1_fw_public_ip "chmod +x /home/$admin_username/opnsense_init.sh && sh /home/$admin_username/opnsense_init.sh"
rm ~/config.xml $opnsense_init_file

ssh-keygen -R $hub1_fw_public_ip
ssh-keygen -R $onprem1_fw_public_ip

# waiting on hub1 vpn gw to finish deployment
hub1_gw_id=$(az network vnet-gateway show -g $rg -n $hub1_vnet_name-gw --query id -o tsv | tr -d '\r')
wait_until_finished $hub1_gw_id

# Getting hub1 VPN GW details
echo -e "\e[1;36mGetting $hub1_vnet_name-gw VPN Gateway details...\e[0m"
hub1_gw_pubip0=$(az network vnet-gateway show -n $hub1_vnet_name-gw -g $rg --query 'bgpSettings.bgpPeeringAddresses[0].tunnelIpAddresses[0]' -o tsv | tr -d '\r') && echo $hub1_vnet_name-gw: $hub1_gw_pubip0
hub1_gw_pubip1=$(az network vnet-gateway show -n $hub1_vnet_name-gw -g $rg --query 'bgpSettings.bgpPeeringAddresses[1].tunnelIpAddresses[0]' -o tsv | tr -d '\r') && echo $hub1_vnet_name-gw: $hub1_gw_pubip1
hub1_gw_bgp_ip0=$(az network vnet-gateway show -n $hub1_vnet_name-gw -g $rg --query 'bgpSettings.bgpPeeringAddresses[0].defaultBgpIpAddresses[0]' -o tsv | tr -d '\r') && echo $hub1_vnet_name-gw: $hub1_gw_bgp_ip0
hub1_gw_bgp_ip1=$(az network vnet-gateway show -n $hub1_vnet_name-gw -g $rg --query 'bgpSettings.bgpPeeringAddresses[1].defaultBgpIpAddresses[0]' -o tsv | tr -d '\r') && echo $hub1_vnet_name-gw: $hub1_gw_bgp_ip1
hub1_gw_asn=$(az network vnet-gateway show -n $hub1_vnet_name-gw -g $rg --query bgpSettings.asn -o tsv | tr -d '\r') && echo $hub1_vnet_name-gw: $hub1_gw_asn

# creating VPN connection between hub1 vpn gw and onprem1 gw
echo -e "\e[1;36mCreating S2S VPN Connection between Azure VPN Gateway $hub1_vnet_name and $onprem1_vnet_name gateway...\e[0m"
az network vpn-connection create -g $rg -n $hub1_vnet_name-gw-to-$onprem1_vnet_name-gw-s2s-connection -l $location --vnet-gateway1 $hub1_vnet_name-gw --local-gateway2 $onprem1_vnet_name-gw --shared-key $psk --enable-bgp -o none

# hub1 and h1spoke vnet peering
echo -e "\e[1;36mCreating $h1spoke_vnet_name VNet peering...\e[0m"
az network vnet peering create -g $rg --name $h1spoke_vnet_name-to-$hub1_vnet_name --vnet-name $h1spoke_vnet_name --remote-vnet $hub1_vnet_name --allow-vnet-access --allow-forwarded-traffic --use-remote-gateways -o none
az network vnet peering create -g $rg --name $hub1_vnet_name-to-$h1spoke_vnet_name --vnet-name $hub1_vnet_name --remote-vnet $h1spoke_vnet_name --allow-vnet-access --allow-forwarded-traffic --allow-gateway-transit -o none

# DNS Resolver
dns_resolver_name=$hub1_vnet_name-dnsresolver
az extension add --name dns-resolver -o none
echo -e "\e[1;36mCreating Azure Private DNS Resolver ($dns_resolver_name) in $hub1_vnet_name VNet...\e[0m"
az dns-resolver create -g $rg -n $dns_resolver_name -l $location --id $hub1_vnetid -o none
# inbound endpoint
echo -e "\e[1;36mCreating an inbound endpoint for Azure Private DNS Resolver ($dns_resolver_name)...\e[0m"
az dns-resolver inbound-endpoint create -g $rg -n inbound-endpoint --dns-resolver-name $dns_resolver_name --ip-configurations '[{"private-ip-address":"","private-ip-allocation-method":"Dynamic","id":"'$in_subnetid'"}]' -o none
dns_resolver_ip=$(az dns-resolver inbound-endpoint show -g $rg -n inbound-endpoint --dns-resolver-name $dns_resolver_name --query ipConfigurations[0].privateIpAddress -o tsv | tr -d '\r') && echo $hub1_vnet_name-dnsresolver IP address: $dns_resolver_ip
# outbound endpoint
echo -e "\e[1;36mCreating an outbound endpoint for Azure Private DNS Resolver ($dns_resolver_name)...\e[0m"
az dns-resolver outbound-endpoint create --dns-resolver-name $dns_resolver_name -g $rg -n outbound-endpoint --id $out_subnetid -o none
outepid=$(az dns-resolver outbound-endpoint show -g $rg -n outbound-endpoint --dns-resolver-name $dns_resolver_name --query id -o tsv | tr -d '\r')
# outbound ruleset to onprem
echo -e "\e[1;36mCreating a rule set for $domain_name on Azure Private DNS Resolver ($dns_resolver_name)...\e[0m"
az dns-resolver forwarding-ruleset create -g $rg -l $location --dns-forwarding-ruleset-name onprem-${domain_netbios}-ruleset --outbound-endpoints [{id:"$outepid"}] -o none
# oubound dns rule
echo -e "\e[1;36mCreating an outbound rule for $domain_name on Azure Private DNS Resolver ($dns_resolver_name)...\e[0m"
az dns-resolver forwarding-rule create -g $rg -n ${domain_netbios}-rule --domain-name ${domain_name}. --forwarding-rule-state Enabled --ruleset-name onprem-${domain_netbios}-ruleset --target-dns-servers '[{ip-address:'$onprem1_dc_ip',port:'53'}]' -o none
# hub dns resolver link with outbound ruleset
echo -e "\e[1;36mCreating a vnet link between $domain_name ruleset and $hub1_vnet_name VNet...\e[0m"
az dns-resolver vnet-link create -g $rg -n $hub1_vnet_name-link --ruleset-name onprem-${domain_netbios}-ruleset --id $hub1_vnetid -o none
echo -e "\e[1;36mCreating a vnet link between $domain_name ruleset and $h1spoke_vnet_name VNet...\e[0m"
az dns-resolver vnet-link create -g $rg -n $h1spoke_vnet_name-link --ruleset-name onprem-${domain_netbios}-ruleset --id $h1spoke_vnetid -o none

# Enable Conditional Forwarder on DC VM
echo -e "\e[1;36mEnabling Conditional Forwarder on $onprem1_vnet_name DC VM...\e[0m"
pshell_file=dns.ps1
cat <<EOF > $pshell_file
Add-DnsServerConditionalForwarderZone -Name "blob.core.windows.net" -MasterServers $dns_resolver_ip
Set-DnsServerForwarder -IPAddress 1.1.1.1
EOF
# Run the script on DC VM
az vm run-command invoke -g $rg -n $onprem1_vnet_name-dc --command-id RunPowerShellScript --scripts @dns.ps1 --query "value[0].message" -o tsv

# clean up script file
rm $pshell_file

# Update DNS Server on onprem1 and o1spoke VNet to DC IP
echo -e "\e[1;36mUpdate DNS Server on $onprem1_vnet_name and $o1spoke_vnet_name VNets to DC IP ($onprem1_dc_ip)...\e[0m"
az network vnet update -g $rg -n $onprem1_vnet_name --dns-servers $onprem1_dc_ip "168.63.129.16" -o none
az network vnet update -g $rg -n $o1spoke_vnet_name --dns-servers $onprem1_dc_ip "168.63.129.16" -o none
echo -e "\e[1;36mRestarting onprem1 VMs after updating DNS settings in their VNet...\e[0m"
az vm restart -g $rg -n $onprem1_vnet_name --force --no-wait
az vm restart -g $rg -n $o1spoke_vnet_name --force --no-wait
az vm restart -g $rg -n $onprem1_vnet_name-lx --force --no-wait
az vm restart -g $rg -n $onprem1_vnet_name-dc --force --no-wait
az vm restart -g $rg -n $o1spoke_vnet_name-lx --force --no-wait

#######################
# onprem1 VPN Config  #
#######################
echo -e "\e[1;36mCreating S2S/BGP VPN Config files for $onprem1_vnet_name-gw gateway VM...\e[0m"
# ipsec.secrets
psk_file=~/ipsec.secrets
cat <<EOF > $psk_file
$onprem1_gw_pubip $hub1_gw_pubip0 : PSK $psk
$onprem1_gw_pubip $hub1_gw_pubip1 : PSK $psk
EOF

# ipsec.conf
ipsec_file=~/ipsec.conf
cat <<EOF > $ipsec_file
conn %default
         # Authentication Method : Pre-Shared Key
         leftauth=psk
         rightauth=psk
         ike=aes256-sha1-modp1024!
         ikelifetime=28800s
         # Phase 1 Negotiation Mode : main
         aggressive=no
         esp=aes256-sha1!
         lifetime=3600s
         keylife=3600s
         type=tunnel
         dpddelay=10s
         dpdtimeout=30s
         keyexchange=ikev2
         rekey=yes
         reauth=no
         dpdaction=restart
         closeaction=restart
         leftsubnet=0.0.0.0/0,::/0
         rightsubnet=0.0.0.0/0,::/0
         leftupdown=/etc/strongswan.d/ipsec-vti.sh
         installpolicy=yes
         compress=no
         mobike=no
conn $hub1_vnet_name-gw0
         # OnPrem Gateway Private IP Address :
         left=$onprem1_gw_private_ip
         # OnPrem Gateway Public IP Address :
         leftid=$onprem1_gw_pubip
         # Azure VPN Gateway Public IP address :
         right=$hub1_gw_pubip0
         rightid=$hub1_gw_pubip0
         auto=start
         # unique number per IPSEC Tunnel eg. 100, 101 etc
         mark=101
conn $hub1_vnet_name-gw1
         # OnPrem Gateway Private IP Address :
         left=$onprem1_gw_private_ip
         # OnPrem Gateway Public IP Address :
         leftid=$onprem1_gw_pubip
         # Azure VPN Gateway Public IP address :
         right=$hub1_gw_pubip1
         rightid=$hub1_gw_pubip1
         auto=start
         # unique number per IPSEC Tunnel eg. 100, 101 etc
         mark=102
EOF


# ipsec-vti.sh
ipsec_vti_file=~/ipsec-vti.sh
tee -a $ipsec_vti_file > /dev/null <<'EOT'
#!/bin/bash

#
# /etc/strongswan.d/ipsec-vti.sh
#

IP=$(which ip)
IPTABLES=$(which iptables)
PLUTO_MARK_OUT_ARR=(${PLUTO_MARK_OUT//// })
PLUTO_MARK_IN_ARR=(${PLUTO_MARK_IN//// })
case "$PLUTO_CONNECTION" in
  $hub1_vnet_name-gw0)
    VTI_INTERFACE=vti0
    VTI_LOCALADDR=$onprem1_gw_vti0/32
    VTI_REMOTEADDR=$hub1_gw_bgp_ip0/32
    echo "`date` - ${PLUTO_VERB} - ${PLUTO_CONNECTION} - $VTI_INTERFACE" >> /tmp/vtitrace.log
    ;;
  $hub1_vnet_name-gw1)
    VTI_INTERFACE=vti1
    VTI_LOCALADDR=$onprem1_gw_vti1/32
    VTI_REMOTEADDR=$hub1_gw_bgp_ip1/32
    echo "`date` - ${PLUTO_VERB} - ${PLUTO_CONNECTION} - $VTI_INTERFACE" >> /tmp/vtitrace.log
    ;;
esac
case "${PLUTO_VERB}" in
    up-client)
        $IP link add ${VTI_INTERFACE} type vti local ${PLUTO_ME} remote ${PLUTO_PEER} okey ${PLUTO_MARK_OUT_ARR[0]} ikey ${PLUTO_MARK_IN_ARR[0]}
        sysctl -w net.ipv4.conf.${VTI_INTERFACE}.disable_policy=1
        sysctl -w net.ipv4.conf.${VTI_INTERFACE}.rp_filter=2 || sysctl -w net.ipv4.conf.${VTI_INTERFACE}.rp_filter=0
        $IP addr add ${VTI_LOCALADDR} remote ${VTI_REMOTEADDR} dev ${VTI_INTERFACE}
        $IP link set ${VTI_INTERFACE} up mtu 1350
        $IPTABLES -t mangle -I FORWARD -o ${VTI_INTERFACE} -p tcp -m tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
        $IPTABLES -t mangle -I INPUT -p esp -s ${PLUTO_PEER} -d ${PLUTO_ME} -j MARK --set-xmark ${PLUTO_MARK_IN}
        $IP route flush table 220
        ;;
    down-client)
        $IP link del ${VTI_INTERFACE}
        $IPTABLES -t mangle -D FORWARD -o ${VTI_INTERFACE} -p tcp -m tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
        $IPTABLES -t mangle -D INPUT -p esp -s ${PLUTO_PEER} -d ${PLUTO_ME} -j MARK --set-xmark ${PLUTO_MARK_IN}
        ;;
esac

# Enable IPv4 forwarding
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv4.conf.eth0.disable_xfrm=1
sysctl -w net.ipv4.conf.eth0.disable_policy=1
EOT

sed -i "/\$onprem1_gw_vti0/ s//$onprem1_gw_vti0/" $ipsec_vti_file
sed -i "/\$onprem1_gw_vti1/ s//$onprem1_gw_vti1/" $ipsec_vti_file
sed -i "/\$hub1_gw_bgp_ip0/ s//$hub1_gw_bgp_ip0/" $ipsec_vti_file
sed -i "/\$hub1_gw_bgp_ip1/ s//$hub1_gw_bgp_ip1/" $ipsec_vti_file
sed -i "/\$hub1_vnet_name-gw0/ s//$hub1_vnet_name-gw0/" $ipsec_vti_file
sed -i "/\$hub1_vnet_name-gw1/ s//$hub1_vnet_name-gw1/" $ipsec_vti_file


# frr.conf
frr_conf_file=~/frr.conf
cat <<EOF > $frr_conf_file
frr version 10.7.1
frr defaults traditional
hostname $onprem1_vnet_name-gw
log syslog informational
no ipv6 forwarding
service integrated-vtysh-config
!
ip route $onprem1_vnet_address $onprem1_gw_nic_default_gw
ip route $o1spoke_vnet_address $onprem1_gw_nic_default_gw
ip route $hub1_gw_bgp_ip0/32 $onprem1_gw_nic_default_gw
ip route $hub1_gw_bgp_ip1/32 $onprem1_gw_nic_default_gw
!
router bgp $onprem1_gw_asn
 bgp router-id $onprem1_gw_private_ip
 no bgp ebgp-requires-policy
 neighbor $hub1_gw_bgp_ip0 remote-as $hub1_gw_asn
 neighbor $hub1_gw_bgp_ip0 description $hub1_vnet_name-gw-0
 neighbor $hub1_gw_bgp_ip0 ebgp-multihop 2
 neighbor $hub1_gw_bgp_ip1 remote-as $hub1_gw_asn
 neighbor $hub1_gw_bgp_ip1 description $hub1_vnet_name-gw-1
 neighbor $hub1_gw_bgp_ip1 ebgp-multihop 2
 !
 address-family ipv4 unicast
  network $onprem1_vnet_address
  network $o1spoke_vnet_address
  neighbor $hub1_gw_bgp_ip0 soft-reconfiguration inbound
  neighbor $hub1_gw_bgp_ip1 soft-reconfiguration inbound
 exit-address-family
exit
!
EOF

##### copy files to onprem gw
echo -e "\e[1;36mCopying and applying S2S/BGP VPN Config files to $onprem1_vnet_name-gw gateway VM...\e[0m"
scp -o StrictHostKeyChecking=no $psk_file $ipsec_file $ipsec_vti_file $frr_conf_file $onprem1_gw_pubip:/home/$admin_username
scp -o StrictHostKeyChecking=no ~/.ssh/id_rsa $onprem1_gw_pubip:/home/$admin_username/.ssh/
# This is needed for clients to connect to internet through onprem gw
ssh -n -o BatchMode=yes -o StrictHostKeyChecking=no $onprem1_gw_pubip "sudo iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE"
ssh -n -o BatchMode=yes -o StrictHostKeyChecking=no $onprem1_gw_pubip "sudo mv /home/$admin_username/frr.conf /etc/frr/frr.conf"
ssh -n -o BatchMode=yes -o StrictHostKeyChecking=no $onprem1_gw_pubip "sudo mv /home/$admin_username/ipsec.* /etc/"
ssh -n -o BatchMode=yes -o StrictHostKeyChecking=no $onprem1_gw_pubip "sudo mv /home/$admin_username/ipsec-vti.sh /etc/strongswan.d/"
ssh -n -o BatchMode=yes -o StrictHostKeyChecking=no $onprem1_gw_pubip "chmod +x /etc/strongswan.d/ipsec-vti.sh" 
ssh -n -o BatchMode=yes -o StrictHostKeyChecking=no $onprem1_gw_pubip "sudo ipsec restart"
ssh -n -o BatchMode=yes -o StrictHostKeyChecking=no $onprem1_gw_pubip "sudo service frr restart"
echo -e "\e[1;36mChecking the status of S2S VPN between $onprem1_vnet_name-gw and $hub1_vnet_name-gw VPN Gateways...\e[0m"
ssh -n -o BatchMode=yes -o StrictHostKeyChecking=no $onprem1_gw_pubip "sudo ipsec status"
ssh -n -o BatchMode=yes -o StrictHostKeyChecking=no $onprem1_gw_pubip "sudo ipsec statusall"
echo -e "\e[1;36mChecking BGP routing on $onprem1_vnet_name-gw gateway vm...\e[0m"
ssh -n -o BatchMode=yes -o StrictHostKeyChecking=no $onprem1_gw_pubip "sudo vtysh -c 'show bgp summary'"
ssh -n -o BatchMode=yes -o StrictHostKeyChecking=no $onprem1_gw_pubip "sudo vtysh -c 'show ip bgp'"
ssh -n -o BatchMode=yes -o StrictHostKeyChecking=no $onprem1_gw_pubip "sudo vtysh -c 'show ip route'"
ssh -n -o BatchMode=yes -o StrictHostKeyChecking=no $onprem1_gw_pubip "sudo vtysh -c 'show ip route bgp'"

# clean up config files
rm $psk_file $ipsec_file $ipsec_vti_file $frr_conf_file $cloudinit_file

# onprem1 and o1spoke vnet peering
echo -e "\e[1;36mCreating a VNet peering between $onprem1_vnet_name VNet and $o1spoke_vnet_name VNet...\e[0m"
az network vnet peering create -g $rg --name $o1spoke_vnet_name-to-$onprem1_vnet_name --vnet-name $o1spoke_vnet_name --remote-vnet $onprem1_vnet_name --allow-vnet-access --allow-forwarded-traffic -o none
az network vnet peering create -g $rg --name $onprem1_vnet_name-to-$o1spoke_vnet_name --vnet-name $onprem1_vnet_name --remote-vnet $o1spoke_vnet_name --allow-vnet-access --allow-forwarded-traffic -o none

# hub1 Gatewaysubnet route table
echo -e "\e[1;36mDeploying $hub1_vnet_name route table and attaching it to GatewaySubnet...\e[0m"
az network route-table create -n $hub1_vnet_name-gw -g $rg -l $location --disable-bgp-route-propagation false -o none
az network route-table route create --address-prefix $hub1_vnet_address -n to-$hub1_vnet_name -g $rg --next-hop-type VirtualAppliance --route-table-name $hub1_vnet_name-gw --next-hop-ip-address $hub1_fw_lan_private_ip -o none
az network route-table route create --address-prefix $h1spoke_vnet_address -n to-$h1spoke_vnet_name -g $rg --next-hop-type VirtualAppliance --route-table-name $hub1_vnet_name-gw --next-hop-ip-address $hub1_fw_lan_private_ip -o none
az network vnet subnet update --vnet-name $hub1_vnet_name -n GatewaySubnet --route-table $hub1_vnet_name-gw -g $rg -o none

# onprem1 gw route table
echo -e "\e[1;36mDeploying $onprem1_vnet_name-gw route table and attaching it to GatewaySubnet...\e[0m"
az network route-table create -n $onprem1_vnet_name-gw -g $rg -l $location --disable-bgp-route-propagation true -o none
az network route-table route create --address-prefix $onprem1_vnet_address -n to-$onprem1_vnet_name -g $rg --next-hop-type VirtualAppliance --route-table-name $onprem1_vnet_name-gw --next-hop-ip-address $onprem1_fw_lan_private_ip -o none
az network route-table route create --address-prefix $o1spoke_vnet_address -n to-$o1spoke_vnet_name -g $rg --next-hop-type VirtualAppliance --route-table-name $onprem1_vnet_name-gw --next-hop-ip-address $onprem1_fw_lan_private_ip -o none
az network vnet subnet update --vnet-name $onprem1_vnet_name -n $onprem1_gw_subnet_name --route-table $onprem1_vnet_name-gw -g $rg -o none

# onprem1 fw wan route table
echo -e "\e[1;36mDeploying $onprem1_vnet_name-fw route table and attaching it to $onprem1_fw_subnet_name...\e[0m"
az network route-table create -n $onprem1_vnet_name-fw -g $rg -l $location --disable-bgp-route-propagation true -o none
az network route-table route create --address-prefix $hub1_vnet_address -n to-$hub1_vnet_name -g $rg --next-hop-type VirtualAppliance --route-table-name $onprem1_vnet_name-fw --next-hop-ip-address $onprem1_gw_private_ip -o none
az network route-table route create --address-prefix $h1spoke_vnet_address -n to-$h1spoke_vnet_name -g $rg --next-hop-type VirtualAppliance --route-table-name $onprem1_vnet_name-fw --next-hop-ip-address $onprem1_gw_private_ip -o none
az network vnet subnet update --vnet-name $onprem1_vnet_name -n $onprem1_fw_subnet_name --route-table $onprem1_vnet_name-fw -g $rg -o none

# hub1 vm subnet route table
echo -e "\e[1;36mDeploying $hub1_vnet_name route table and attaching it to $hub1_vm_subnet_name subnet...\e[0m"
az network route-table create -n $hub1_vnet_name -g $rg -l $location --disable-bgp-route-propagation true -o none
az network route-table route create --address-prefix "0.0.0.0/0" -n default -g $rg --next-hop-type VirtualAppliance --route-table-name $hub1_vnet_name --next-hop-ip-address $hub1_fw_lan_private_ip -o none
az network vnet subnet update --vnet-name $hub1_vnet_name -n $hub1_vm_subnet_name --route-table $hub1_vnet_name -g $rg -o none

# hub1 inbound subnet route table
echo -e "\e[1;36mDeploying $hub1_vnet_name-in-snet-rt route table and attaching it to $hub1_in_subnet subnet...\e[0m"
az network route-table create -n $hub1_vnet_name-in-snet-rt -g $rg -l $location --disable-bgp-route-propagation true -o none
az network route-table route create --address-prefix "0.0.0.0/0" -n default -g $rg --next-hop-type VirtualAppliance --route-table-name $hub1_vnet_name-in-snet-rt --next-hop-ip-address $hub1_fw_lan_private_ip -o none
az network vnet subnet update --vnet-name $hub1_vnet_name -n $hub1_in_subnet --route-table $hub1_vnet_name-in-snet-rt -g $rg -o none

# hub1 outbound subnet route table
echo -e "\e[1;36mDeploying $hub1_vnet_name-out-snet-rt route table and attaching it to $hub1_vm_subnet_name subnet...\e[0m"
az network route-table create -n $hub1_vnet_name-out-snet-rt -g $rg -l $location --disable-bgp-route-propagation true -o none
az network route-table route create --address-prefix "0.0.0.0/0" -n default -g $rg --next-hop-type VirtualAppliance --route-table-name $hub1_vnet_name-out-snet-rt --next-hop-ip-address $hub1_fw_lan_private_ip -o none
az network vnet subnet update --vnet-name $hub1_vnet_name -n $hub1_out_subnet --route-table $hub1_vnet_name-out-snet-rt -g $rg -o none

# h1spoke route table
echo -e "\e[1;36mDeploying $h1spoke_vnet_name route table and attaching it to $h1spoke_vm_subnet_name subnet...\e[0m"
az network route-table create -n $h1spoke_vnet_name -g $rg -l $location --disable-bgp-route-propagation true -o none
az network route-table route create --address-prefix "0.0.0.0/0" -n default -g $rg --next-hop-type VirtualAppliance --route-table-name $h1spoke_vnet_name --next-hop-ip-address $hub1_fw_lan_private_ip -o none
az network vnet subnet update --vnet-name $h1spoke_vnet_name -n $h1spoke_vm_subnet_name --route-table $h1spoke_vnet_name -g $rg -o none

# onprem1 route table
echo -e "\e[1;36mDeploying $onprem1_vnet_name route table and attaching it to $onprem1_vm_subnet_name subnet...\e[0m"
az network route-table create -n $onprem1_vnet_name -g $rg -l $location --disable-bgp-route-propagation true -o none
az network route-table route create --address-prefix "0.0.0.0/0" -n default -g $rg --next-hop-type VirtualAppliance --route-table-name $onprem1_vnet_name --next-hop-ip-address $onprem1_fw_lan_private_ip -o none
az network vnet subnet update --vnet-name $onprem1_vnet_name -n $onprem1_vm_subnet_name --route-table $onprem1_vnet_name -g $rg -o none

# o1spoke route table
echo -e "\e[1;36mDeploying $o1spoke_vnet_name route table and attaching it to $o1spoke_vm_subnet_name subnet...\e[0m"
az network route-table create -n $o1spoke_vnet_name -g $rg -l $location --disable-bgp-route-propagation true -o none
az network route-table route create --address-prefix "0.0.0.0/0" -n default -g $rg --next-hop-type VirtualAppliance --route-table-name $o1spoke_vnet_name --next-hop-ip-address $onprem1_fw_lan_private_ip -o none
az network vnet subnet update --vnet-name $o1spoke_vnet_name -n $o1spoke_vm_subnet_name --route-table $o1spoke_vnet_name -g $rg -o none

#############
# Diagnosis #
#############


# Checking storage account dns resolution from onprem-dc VM
echo -e "\e[1;36mChecking DNS Resolution from $onprem1_vnet_name-dc VM to blob endpoint: $blob_endpoint...\e[0m"
az vm run-command invoke -g $rg -n $onprem1_vnet_name-dc --command-id RunPowerShellScript --scripts "nslookup $blob_endpoint" --query "value[0].message" -o tsv

echo -e "\e[1;36mChecking DNS Resolution from $onprem1_vnet_name VM to blob endpoint: $blob_endpoint...\e[0m"
az vm run-command invoke -g $rg -n $onprem1_vnet_name --command-id RunPowerShellScript --scripts "nslookup $blob_endpoint" --query "value[0].message" -o tsv

echo -e "\e[1;36mChecking DNS Resolution from $o1spoke_vnet_name VM to blob endpoint: $blob_endpoint...\e[0m"
az vm run-command invoke -g $rg -n $o1spoke_vnet_name --command-id RunPowerShellScript --scripts "nslookup $blob_endpoint" --query "value[0].message" -o tsv

# Checking DNS resolution of onpremise domain from hub1 vm
echo -e "\e[1;36mChecking DNS Resolution from $hub1_vnet_name VM to $domain_name domain...\e[0m"
az vm run-command invoke -g $rg -n $hub1_vnet_name --command-id RunPowerShellScript --scripts "nslookup $onprem1_vnet_name-dc.$domain_name; nslookup $blob_endpoint" --query "value[0].message" -o tsv

# Checking DNS resolution of onpremise domain from h1spoke vm
echo -e "\e[1;36mChecking DNS Resolution from $h1spoke_vnet_name VM to $domain_name domain...\e[0m"
az vm run-command invoke -g $rg -n $h1spoke_vnet_name --command-id RunPowerShellScript --scripts "nslookup $onprem1_vnet_name-dc.$domain_name; nslookup $blob_endpoint" --query "value[0].message" -o tsv

