az network nic create -g $rg -n $onprem1_vnet_name -l $location --vnet-name $onprem1_vnet_name --subnet $onprem1_vm_subnet_name -o none
az vm create -g $rg -n $onprem1_vnet_name -l $location --image Win2022Datacenter --nics $onprem1_vnet_name --os-disk-name $onprem1_vnet_name --size $win_vm_size --admin-username $admin_username --admin-password $admin_password --no-wait
onprem1_vm_ip=$(az network nic show -g $rg -n $onprem1_vnet_name --query ipConfigurations[0].privateIPAddress -o tsv | tr -d '\r') && echo $onprem1_vnet_name vm private ip: $onprem1_vm_ip

# onprem1-lx vm
echo -e "\e[1;36mDeploying $onprem1_vnet_name-lx VM...\e[0m"
az network nic create -g $rg -n $onprem1_vnet_name-lx -l $location --vnet-name $onprem1_vnet_name --subnet $onprem1_vm_subnet_name -o none
az vm create -g $rg -n $onprem1_vnet_name-lx -l $location --image Ubuntu2204 --nics $onprem1_vnet_name-lx --os-disk-name $onprem1_vnet_name-lx --size $vm_size --admin-username $admin_username --admin-password $admin_password --no-wait
onprem1_lx_vm_ip=$(az network nic show -g $rg -n $onprem1_vnet_name-lx --query ipConfigurations[0].privateIPAddress -o tsv | tr -d '\r') && echo $onprem1_vnet_name-lx vm private ip: $onprem1_lx_vm_ip

# h1spoke vm
